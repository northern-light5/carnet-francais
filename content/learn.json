  "quiz": [
    {"q": "Choose the correct article: ___ eau est froide.", "options": ["Le", "La", "L'", "Les"], "answer": 2, "explain": "Before a vowel sound, le/la become l'."},
    {"q": "Hier, nous ___ au cinéma.", "options": ["allons", "sommes allés", "irons", "allions"], "answer": 1, "explain": "A completed action yesterday → passé composé; aller takes être."},
    {"q": "Il faut que tu ___ tes devoirs.", "options": ["fais", "fasses", "feras", "faisais"], "answer": 1, "explain": "'Il faut que' is followed by the subjunctive."},
    {"q": "Je n'ai ___ vu.", "options": ["personne", "rien", "jamais", "aucun"], "answer": 1, "explain": "'Je n'ai rien vu' = I didn't see anything."},
    {"q": "Si j'avais le temps, je ___ le français tous les jours.", "options": ["étudie", "étudierai", "étudierais", "étudiais"], "answer": 2, "explain": "Si + imparfait → conditionnel présent."},
    {"q": "C'est la ville ___ je suis né.", "options": ["que", "qui", "dont", "où"], "answer": 3, "explain": "'Où' introduces a place (or time) in relative clauses."},
    {"q": "Elle parle ___ que son frère.", "options": ["plus bien", "mieux", "meilleur", "plus bon"], "answer": 1, "explain": "The comparative of the adverb 'bien' is 'mieux'."},
    {"q": "Les fleurs ___ j'ai achetées sont belles.", "options": ["que", "qui", "dont", "lesquelles"], "answer": 0, "explain": "'Que' is the direct object; note the agreement 'achetées'."}
